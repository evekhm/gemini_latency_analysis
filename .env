# Configured for LLM logging requests/responses to BihQuery
PROJECT_ID="llm-latency-ek-01"
LOCATION="us-central1"
DATASET_ID="logging"

# Latency Agent Configuration
GOOGLE_GENAI_USE_VERTEXAI=TRUE
AGENT_MODEL_ID="gemini-2.5-pro"
AGENT_REGION="us-central1"
AGENT_TABLE_ID="2p5-flash,3-pro,2p5-pro"  # Tables used for analysis, comma separated lists

# Open Telemetry
OTEL_SERVICE_NAME=adk-otel-agent
OTEL_PYTHON_LOGGING_AUTO_INSTRUMENTATION_ENABLED=true
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=true

VIEW_ID="llm_logging_view"